{
  "name": "donka-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/assemble-sources.mjs && next build",
    "dev": "node scripts/assemble-sources.mjs && next dev",
    "start": "serve out",
    "types:check": "node scripts/assemble-sources.mjs && next typegen && tsc --noEmit",
    "sources:refs": "node scripts/source-refs.mjs",
    "check:links": "node scripts/check-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test scripts/*.test.mjs",
    "audit:security": "pnpm audit --audit-level high",
    "test:e2e": "playwright test",
    "test:e2e:release": "node scripts/test-release.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "prettier": "3.9.9",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "pnpm": {
    "overrides": {
      "serve>compression": "1.8.2"
    }
  }
}
